# Targets for Vite dev server proxy (read by vite.config.js)
VITE_GATEWAY_URL=http://localhost:8080
VITE_KEYCLOAK_TARGET=http://localhost:8443

# Left empty so browser makes relative requests (/api/..., /realms/...) through Vite proxy
VITE_API_URL=
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=ecom-app
VITE_KEYCLOAK_CLIENT_ID=oauth2-pkce
